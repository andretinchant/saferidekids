<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:converters="clr-namespace:SafeRideKids.Motorista.Maui.Resources.Styles">

    <!-- Converters globais -->
    <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
    <converters:StatusKeyToColorConverter x:Key="StatusKeyToColorConverter" />

    <!-- ContentPage base com cor adaptativa claro/escuro -->
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="Shell.ForegroundColor" Value="White" />
        <Setter Property="Shell.TitleColor" Value="White" />
    </Style>

    <!-- Labels com cor adaptativa -->
    <Style TargetType="Label">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
    </Style>

    <!-- Entry com altura minima 44dp p/ acessibilidade -->
    <Style TargetType="Entry">
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Gray500}" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="MinimumHeightRequest" Value="120" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Gray500}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Botoes — todos minimo 48dp p/ AA -->
    <Style TargetType="Button">
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="BackgroundColor" Value="{StaticResource Gray200}" />
        <Setter Property="TextColor" Value="{StaticResource Gray900}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Botao de acao critica grande — destaque do check-in -->
    <Style x:Key="HeroButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="MinimumHeightRequest" Value="64" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

</ResourceDictionary>
