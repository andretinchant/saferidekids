<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SafeRideKids.Motorista.Maui.ViewModels"
             x:Class="SafeRideKids.Motorista.Maui.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Entrar — Motorista">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">

            <Label Text="SafeRide Motorista"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   SemanticProperties.HeadingLevel="Level1" />

            <Label Text="POC de check-in com biometria facial"
                   FontSize="14"
                   TextColor="{DynamicResource Gray500}"
                   HorizontalOptions="Center" />

            <Entry Placeholder="Email"
                   Text="{Binding Email}"
                   Keyboard="Email"
                   ReturnType="Next"
                   SemanticProperties.Hint="Informe seu email de motorista cadastrado." />

            <Entry Placeholder="Senha"
                   Text="{Binding Password}"
                   IsPassword="True"
                   ReturnType="Next"
                   SemanticProperties.Hint="Informe sua senha." />

            <Entry Placeholder="Tenant"
                   Text="{Binding TenantId}"
                   SemanticProperties.Hint="Identificador da operadora do transporte escolar." />

            <Button Text="Entrar"
                    Command="{Binding SignInCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    Style="{StaticResource PrimaryButton}"
                    SemanticProperties.Hint="Tocar para entrar no app." />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" />

            <Label Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                   TextColor="{DynamicResource StatusRejectedColor}"
                   HorizontalOptions="Center" />

            <Label Text="POC — login simulado. Em producao usa Cognito."
                   FontSize="11"
                   TextColor="{DynamicResource Gray400}"
                   HorizontalOptions="Center"
                   Margin="0,24,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
