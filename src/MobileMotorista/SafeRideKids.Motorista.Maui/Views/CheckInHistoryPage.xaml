<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SafeRideKids.Motorista.Maui.ViewModels"
             xmlns:models="clr-namespace:SafeRideKids.Motorista.Maui.Models"
             x:Class="SafeRideKids.Motorista.Maui.Views.CheckInHistoryPage"
             x:DataType="vm:CheckInHistoryViewModel"
             Title="Check-ins do dia">

    <RefreshView IsRefreshing="{Binding IsBusy}"
                 Command="{Binding LoadCommand}">
        <CollectionView ItemsSource="{Binding Items}"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="Nenhum check-in registrado hoje."
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="{DynamicResource Gray500}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CheckInHistoryItem">
                    <Border StrokeShape="RoundRectangle 10"
                            Stroke="{DynamicResource Gray200}"
                            BackgroundColor="{DynamicResource Surface}"
                            Padding="14"
                            Margin="16,6">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="2">
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="{Binding ChildDisplayName}"
                                   FontAttributes="Bold"
                                   FontSize="16" />
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding OccurredAtLocal, StringFormat='{0:HH:mm}'}"
                                   FontSize="12"
                                   TextColor="{DynamicResource Gray500}" />
                            <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="{Binding AddressLabel}"
                                   FontSize="12"
                                   TextColor="{DynamicResource Gray500}" />
                            <!-- Cor de status via key dinamica -->
                            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                    StrokeShape="RoundRectangle 4"
                                    Padding="6,2"
                                    HorizontalOptions="Start"
                                    BackgroundColor="{Binding StatusKey, Converter={StaticResource StatusKeyToColorConverter}}">
                                <Label Text="{Binding StatusLabel}"
                                       FontSize="10"
                                       TextColor="White" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>
