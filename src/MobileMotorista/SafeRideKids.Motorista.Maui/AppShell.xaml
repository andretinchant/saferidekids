<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:SafeRideKids.Motorista.Maui.Views"
       x:Class="SafeRideKids.Motorista.Maui.AppShell"
       Shell.FlyoutBehavior="Disabled"
       Title="SafeRide Motorista">

    <!-- Tela inicial: login. Demais rotas sao navegadas via Shell.Current.GoToAsync. -->
    <ShellContent
        Title="Entrar"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage" />

</Shell>
