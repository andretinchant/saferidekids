<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Apenas Android e iOS conforme escopo da POC. Plataformas Windows/Mac removidas. -->
		<TargetFrameworks>net8.0-android;net8.0-ios</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>SafeRideKids.Motorista.Maui</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Identidade do app motorista. -->
		<ApplicationTitle>SafeRide Motorista</ApplicationTitle>
		<ApplicationId>com.saferidekids.poc.motorista</ApplicationId>
		<ApplicationIdGuid>5b3f0e0e-2c10-4a52-9c11-2b1a0c2b3d4e</ApplicationIdGuid>

		<!-- Versionamento da POC. -->
		<ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App icon e splash com tema base; assets reais ficam em Resources/AppIcon e Splash. -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1B5E20" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1B5E20" BaseSize="128,128" />

		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*.ttf" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<!-- MAUI + MVVM + Toolkit. -->
		<PackageReference Include="Microsoft.Maui.Controls" Version="8.0.40" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="8.0.40" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />
		<PackageReference Include="CommunityToolkit.Maui" Version="9.0.3" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />

		<!-- Cliente HTTP tipado p/ backend. -->
		<PackageReference Include="Refit" Version="7.1.2" />
		<PackageReference Include="Refit.HttpClientFactory" Version="7.1.2" />

		<!-- Fila offline. Sem armazenamento de biometria; apenas metadados. -->
		<PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
		<PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.8" />
	</ItemGroup>

</Project>
