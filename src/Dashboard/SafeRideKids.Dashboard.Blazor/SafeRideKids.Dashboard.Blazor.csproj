<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SafeRideKids.Dashboard.Blazor</RootNamespace>
    <AssemblyName>SafeRideKids.Dashboard.Blazor</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Usuário-secrets para POC: appsettings.json tem placeholders, valores reais via user-secrets -->
    <UserSecretsId>saferidekids-dashboard-poc</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- MudBlazor: design system com dark/light, MudChart, MudDataGrid -->
    <PackageReference Include="MudBlazor" Version="6.20.0" />

    <!-- Refit: chamadas tipadas ao backend -->
    <PackageReference Include="Refit" Version="7.2.22" />
    <PackageReference Include="Refit.HttpClientFactory" Version="7.2.22" />

    <!-- Autenticação JWT — placeholder Cognito (lê issuer/authority via config) -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="8.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Cookies" Version="2.3.0" />

    <!-- Logging -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
  </ItemGroup>

</Project>
