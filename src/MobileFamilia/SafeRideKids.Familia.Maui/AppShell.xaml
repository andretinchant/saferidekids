<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:SafeRideKids.Familia.Maui.Views"
       x:Class="SafeRideKids.Familia.Maui.AppShell"
       Shell.FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="True">

    <!--
      Estrutura de navegação:
      //login   → tela de autenticação (rota raiz)
      //children → "Minhas crianças" (rota raiz após login)
      addChild   → cadastro de criança (subpush)
      consent    → tela LGPD destacada (subpush)
      enrollment → wizard de captura facial (subpush)
      childDetail → detalhe + DSR-delete (subpush)
    -->

    <ShellContent Route="login"
                  ContentTemplate="{DataTemplate views:LoginPage}"
                  Title="Entrar" />

    <ShellContent Route="children"
                  ContentTemplate="{DataTemplate views:MyChildrenPage}"
                  Title="Minhas Crianças" />

</Shell>
